---
import type { SiteContent } from '../content';

interface Props {
  caseStudy: SiteContent['caseStudies']['patentpath'];
  summary: string;
  labels: SiteContent['caseStudyLabels'];
}

const { caseStudy, summary, labels } = Astro.props;
const { story } = caseStudy;
const screenshots = [
  [story.screenshots.overview, 'eager'],
  [story.screenshots.patents, 'lazy'],
  [story.screenshots.riskCheck, 'lazy'],
] as const;
---

<div class="patentpath-story" data-patentpath-story>
  <header class="patentpath-story__header">
    <p class="patentpath-story__context">{story.context}</p>
    <h1>{caseStudy.outcome}</h1>
    <p class="patentpath-story__intro">{summary}</p>
  </header>

  <section aria-labelledby="patentpath-problem-heading">
    <h2 id="patentpath-problem-heading">{labels.problem}</h2>
    <p>{caseStudy.problem}</p>
  </section>

  <section
    class="patentpath-story__walkthrough"
    data-patentpath-walkthrough
    aria-labelledby="patentpath-workflow-heading"
  >
    <h2 id="patentpath-workflow-heading">{story.workflowHeading}</h2>
    <div class="patentpath-story__walkthrough-grid">
      <div class="patentpath-story__stage-wrap">
        <div class="patentpath-story__stage">
          <div class="patentpath-story__stage-controls">
            {
              screenshots.map((screen, index) => (
                <button
                  type="button"
                  data-patentpath-stage-button
                  data-screen-index={String(index)}
                  aria-label={screen[0].alt}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                >
                  <span>{String(index + 1).padStart(2, '0')}</span>
                </button>
              ))
            }
          </div>
          <div class="patentpath-story__stage-media">
            {
              screenshots.map((screen, index) => (
                <figure
                  class:list={[
                    'patentpath-story__figure',
                    'patentpath-story__stage-figure',
                    { 'is-active': index === 0 },
                  ]}
                  data-patentpath-stage-figure
                  data-screen-index={String(index)}
                  aria-hidden={index === 0 ? 'false' : 'true'}
                >
                  <img
                    data-patentpath-screenshot
                    src={screen[0].src}
                    alt={screen[0].alt}
                    width={screen[0].width}
                    height={screen[0].height}
                    loading={screen[1]}
                    decoding="async"
                  />
                  <figcaption>{screen[0].caption}</figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </div>

      <ol class="patentpath-story__workflow">
        {
          story.workflow.map((step, index) => (
            <li
              class:list={{ 'is-active': index === 0 }}
              data-patentpath-workflow-step
              data-patentpath-scene
              data-screen-index={String(Math.min(index, screenshots.length - 1))}
            >
              <span aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section aria-labelledby="patentpath-differentiators-heading">
    <h2 id="patentpath-differentiators-heading">
      {story.differentiatorsHeading}
    </h2>
    <ol class="patentpath-story__differentiators">
      {
        story.differentiators.map((item, index) => (
          <li data-patentpath-differentiator>
            <span aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <p>{item}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section
    aria-labelledby="patentpath-responsibility-heading"
    data-case-section="responsibility"
  >
    <h2 id="patentpath-responsibility-heading">
      {labels.responsibility}
    </h2>
    <p>{caseStudy.responsibility}</p>
    <h3>{labels.build}</h3>
    <ol class="patentpath-story__contribution">
      {
        caseStudy.build.map((item, index) => (
          <li data-patentpath-contribution>
            <span aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <p>{item}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="patentpath-architecture-heading">
    <h2 id="patentpath-architecture-heading">
      {story.architectureHeading}
    </h2>
    <ol class="patentpath-story__architecture">
      {
        story.architecture.map((node) => (
          <li data-patentpath-architecture-node>{node}</li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="patentpath-evidence-heading">
    <h2 id="patentpath-evidence-heading">{labels.evidence}</h2>
    <ul>
      {caseStudy.evidence.map((item) => <li>{item}</li>)}
    </ul>
    <p class="patentpath-story__disclaimer" data-patentpath-disclaimer>
      {story.disclaimer}
    </p>
  </section>
</div>

<style>
  .patentpath-story__header {
    padding-bottom: clamp(2.5rem, 6vw, 5rem);
    border-bottom: 1px solid var(--line);
  }

  .patentpath-story__context {
    margin-bottom: 1.25rem;
    color: var(--accent);
    font-weight: 700;
  }

  .patentpath-story__header h1 {
    max-width: 17ch;
    margin-bottom: 1.5rem;
    font-size: clamp(2.4rem, 6vw, 5.5rem);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .patentpath-story__intro {
    max-width: 65ch;
    margin-bottom: 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }

  .patentpath-story > section {
    scroll-margin-top: calc(var(--header-height, 75px) + 1.25rem);
    padding: clamp(2.5rem, 6vw, 5rem) 0;
    margin: 0;
    border-bottom: 1px solid var(--line);
  }

  .patentpath-story__walkthrough-grid {
    display: grid;
    grid-template-areas: 'steps stage';
    grid-template-columns: minmax(14rem, 0.85fr) minmax(0, 1.5fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .patentpath-story__stage-wrap {
    grid-area: stage;
    align-self: stretch;
    min-width: 0;
  }

  .patentpath-story__stage {
    position: sticky;
    top: calc(
      var(--header-height, 75px) + clamp(1.5rem, 4vw, 3rem)
    );
  }

  .patentpath-story__stage-controls {
    display: flex;
    gap: 0.35rem;
    justify-content: flex-end;
    margin-bottom: 0.75rem;
  }

  .patentpath-story__stage-controls button {
    position: relative;
    display: grid;
    place-items: center;
    width: 3rem;
    min-height: 44px;
    padding: 0;
    border: 0;
    color: var(--muted);
    background: transparent;
    font: inherit;
    font-size: 0.65rem;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }

  .patentpath-story__stage-controls button::after {
    position: absolute;
    right: 0;
    bottom: 0.35rem;
    left: 0;
    height: 1px;
    background: var(--line);
    content: '';
    transform: scaleX(0.45);
    transform-origin: left center;
    transition:
      background-color var(--motion-fast) var(--ease-settle),
      transform var(--motion-base) var(--ease-out);
  }

  .patentpath-story__stage-controls button[aria-pressed='true'] {
    color: var(--accent);
  }

  .patentpath-story__stage-controls button[aria-pressed='true']::after {
    background: var(--accent);
    transform: scaleX(1);
  }

  .patentpath-story__stage-media {
    position: relative;
    aspect-ratio: 3 / 2;
    margin-bottom: 5rem;
  }

  .patentpath-story__figure {
    margin: 0;
  }

  .patentpath-story__stage-figure {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transform: translate3d(12px, 0, 0) scale(0.992);
    transition:
      opacity var(--motion-base) var(--ease-out),
      transform var(--motion-base) var(--ease-out);
  }

  .patentpath-story__stage-figure.is-active {
    z-index: 1;
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  .patentpath-story__figure img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .patentpath-story__figure figcaption {
    position: absolute;
    top: calc(100% + 1rem);
    left: 0;
    max-width: 70ch;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .patentpath-story h2 {
    scroll-margin-top: calc(var(--header-height, 75px) + 1.25rem);
    max-width: 22ch;
    margin-bottom: 1.5rem;
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    letter-spacing: -0.035em;
  }

  .patentpath-story h3 {
    font-size: 1rem;
  }

  .patentpath-story__workflow,
  .patentpath-story__differentiators,
  .patentpath-story__contribution,
  .patentpath-story__architecture {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .patentpath-story__workflow {
    display: grid;
    grid-area: steps;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .patentpath-story__workflow li {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    min-height: clamp(14rem, 38svh, 22rem);
    padding: clamp(1.5rem, 4vw, 2.5rem) 0;
    color: var(--muted);
    transition: color var(--motion-base) var(--ease-settle);
  }

  .patentpath-story__workflow li + li {
    border-top: 1px solid var(--line);
  }

  .patentpath-story__workflow li.is-active {
    color: var(--ink);
  }

  .patentpath-story__workflow li.is-active h3 {
    color: var(--accent);
  }

  .patentpath-story__workflow span,
  .patentpath-story__differentiators span,
  .patentpath-story__contribution span {
    display: block;
    margin-bottom: 1rem;
    color: var(--accent);
    font-size: 0.65rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .patentpath-story__workflow h3 {
    margin-bottom: 0.75rem;
  }

  .patentpath-story__workflow p,
  .patentpath-story__differentiators p,
  .patentpath-story__contribution p {
    margin: 0;
  }

  .patentpath-story__differentiators,
  .patentpath-story__contribution {
    border-top: 1px solid var(--line);
  }

  .patentpath-story__differentiators li,
  .patentpath-story__contribution li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
  }

  .patentpath-story__differentiators span,
  .patentpath-story__contribution span {
    margin: 0;
  }

  .patentpath-story__contribution {
    margin-top: 1.5rem;
  }

  .patentpath-story__architecture {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .patentpath-story__architecture li {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 7rem;
    padding: 1rem;
    text-align: center;
    font-weight: 700;
  }

  .patentpath-story__architecture li + li {
    border-left: 1px solid var(--line);
  }

  .patentpath-story__architecture li + li::before {
    position: absolute;
    left: 0;
    padding: 0.25rem;
    color: var(--accent);
    background: var(--paper);
    content: '→';
    transform: translateX(-50%);
  }

  .patentpath-story__disclaimer {
    max-width: 65ch;
    padding: 1rem;
    margin: 1.5rem 0 0;
    color: var(--muted);
    border: 1px solid var(--line);
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .patentpath-story__walkthrough-grid {
      grid-template-areas:
        'stage'
        'steps';
      grid-template-columns: minmax(0, 1fr);
    }

    .patentpath-story__stage {
      position: static;
    }

    .patentpath-story__workflow {
      grid-template-columns: minmax(0, 1fr);
    }

    .patentpath-story__workflow li {
      min-height: 0;
    }

    .patentpath-story__architecture {
      grid-template-columns: minmax(0, 1fr);
    }

    .patentpath-story__architecture li {
      min-height: 0;
      padding: 1.25rem;
    }

    .patentpath-story__architecture li + li {
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .patentpath-story__architecture li + li::before {
      top: 0;
      left: 50%;
      content: '↓';
      transform: translate(-50%, -50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .patentpath-story__stage-figure,
    .patentpath-story__workflow li {
      transition: none;
    }
  }
</style>
