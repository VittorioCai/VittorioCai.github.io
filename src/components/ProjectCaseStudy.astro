---
import { getContent } from '../content';
import type { Locale } from '../content';
import type { Project, ProjectId } from '../content/types';
import { getLocalizedPath } from '../i18n/routes';
import type { RouteKey } from '../i18n/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSafeProjectAction } from '../utils/external-url';
import PatentPathStory from './PatentPathStory.astro';
import ProjectVisual from './ProjectVisual.astro';

type CaseStudyProjectId = ProjectId;

const caseStudyRoutes = {
  patentpath: 'patentpath',
  'english-job-agent': 'jobAgent',
  'news-sentiment': 'newsSentiment',
  'water-quality': 'waterQuality',
} satisfies Record<CaseStudyProjectId, RouteKey>;
const caseStudyOrder: CaseStudyProjectId[] = [
  'patentpath',
  'english-job-agent',
  'news-sentiment',
  'water-quality',
];

interface Props {
  locale: Locale;
  projectId: CaseStudyProjectId;
}

const { locale, projectId } = Astro.props;
const copy = getContent(locale);
const project: Project | undefined = copy.projects.find(
  (entry) => entry.id === projectId,
);

if (!project) {
  throw new Error(`Missing case-study project content for "${projectId}".`);
}

if (!Astro.site) {
  throw new Error('Astro.site is required to build case-study metadata.');
}

const route = caseStudyRoutes[projectId];
const currentProjectIndex = caseStudyOrder.indexOf(projectId);
const nextProjectId =
  caseStudyOrder[(currentProjectIndex + 1) % caseStudyOrder.length];
const nextRoute = caseStudyRoutes[nextProjectId];
const nextProject = copy.projects.find(
  (entry) => entry.id === nextProjectId,
);

if (!nextProject) {
  throw new Error(`Missing next-project content for "${nextProjectId}".`);
}

const caseStudy = copy.caseStudies[projectId];
const patentPathCaseStudy =
  projectId === 'patentpath' ? copy.caseStudies.patentpath : null;
const railSections = patentPathCaseStudy
  ? [
      {
        href: '#patentpath-problem-heading',
        label: copy.caseStudyLabels.problem,
      },
      {
        href: '#patentpath-workflow-heading',
        label: patentPathCaseStudy.story.workflowHeading,
      },
      {
        href: '#patentpath-differentiators-heading',
        label: patentPathCaseStudy.story.differentiatorsHeading,
      },
      {
        href: '#patentpath-responsibility-heading',
        label: copy.caseStudyLabels.responsibility,
      },
      {
        href: '#patentpath-architecture-heading',
        label: patentPathCaseStudy.story.architectureHeading,
      },
      {
        href: '#patentpath-evidence-heading',
        label: copy.caseStudyLabels.evidence,
      },
    ]
  : [
      {
        href: '#case-problem-heading',
        label: copy.caseStudyLabels.problem,
      },
      {
        href: '#case-responsibility-heading',
        label: copy.caseStudyLabels.responsibility,
      },
      {
        href: '#case-build-heading',
        label: copy.caseStudyLabels.build,
      },
      {
        href: '#case-evidence-heading',
        label: copy.caseStudyLabels.evidence,
      },
    ];
const publicLink = getSafeProjectAction(
  project.actions,
  projectId === 'patentpath' ? 'demo' : 'source',
);

const publicLinkLabel =
  projectId === 'patentpath' ? copy.actions.demo : copy.actions.source;
const pageUrl = new URL(getLocalizedPath(locale, route), Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.summary,
  url: pageUrl.href,
  author: {
    '@type': 'Person',
    name: copy.displayName,
    url: new URL('/', Astro.site).href,
  },
  ...(publicLink ? { sameAs: [publicLink] } : {}),
};
const serializedStructuredData = JSON.stringify(structuredData).replace(
  /</g,
  '\\u003c',
);
---

<BaseLayout
  locale={locale}
  route={route}
  title={`${project.title} — ${copy.actions.caseStudy} | ${copy.displayName}`}
  description={project.summary}
>
  <article class="case-study">
    <aside class="case-study__rail">
      <div class="case-study__rail-inner" data-case-rail-inner>
        <p class="section-label">{project.kicker}</p>
        <p class="case-study__project-name">{project.title}</p>

        {
          projectId === 'english-job-agent' && (
            <div class="case-study__visual">
              <ProjectVisual
                projectId="english-job-agent"
                label={`${project.title}: ${project.summary}`}
                stages={copy.visuals.jobAgentStages}
              />
            </div>
          )
        }

        {
          publicLink && (
            <div class="case-study__public-action">
              <div class="text-actions">
                <a class="external" href={publicLink} rel="noreferrer">
                  {publicLinkLabel}
                </a>
              </div>
              {
                projectId === 'patentpath' && project.demoNote ? (
                  <p class="demo-note">{project.demoNote}</p>
                ) : null
              }
            </div>
          )
        }

        <nav
          class="case-study__rail-nav"
          data-case-rail-nav
          aria-label={copy.sections.work}
        >
          <ol>
            {
              railSections.map((section, index) => (
                <li>
                  <a
                    href={section.href}
                    data-case-rail-link
                    aria-current={index === 0 ? 'location' : undefined}
                  >
                    <span aria-hidden="true">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    {section.label}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </div>
    </aside>

    <div class="case-study__body">
      {
        patentPathCaseStudy ? (
          <PatentPathStory
            caseStudy={patentPathCaseStudy}
            summary={project.summary}
            labels={copy.caseStudyLabels}
          />
        ) : (
          <>
            <header class="case-study__header">
              <h1>{caseStudy.outcome}</h1>
              <p class="case-study__intro">{project.summary}</p>
            </header>

            <section aria-labelledby="case-problem-heading">
              <h2 id="case-problem-heading">
                {copy.caseStudyLabels.problem}
              </h2>
              <p>{caseStudy.problem}</p>
            </section>

            <section
              aria-labelledby="case-responsibility-heading"
              data-case-section="responsibility"
            >
              <h2 id="case-responsibility-heading">
                {copy.caseStudyLabels.responsibility}
              </h2>
              <p>{caseStudy.responsibility}</p>
            </section>

            <section aria-labelledby="case-build-heading">
              <h2 id="case-build-heading">{copy.caseStudyLabels.build}</h2>
              <ul>
                {caseStudy.build.map((item) => <li>{item}</li>)}
              </ul>
            </section>

            <section aria-labelledby="case-evidence-heading">
              <h2 id="case-evidence-heading">
                {copy.caseStudyLabels.evidence}
              </h2>
              <ul>
                {caseStudy.evidence.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          </>
        )
      }

      <nav
        class="case-study__navigation"
        aria-label={copy.sections.work}
      >
        <a href={getLocalizedPath(locale, 'work')}>
          ← {copy.caseStudyLabels.backToWork}
        </a>
        <a href={getLocalizedPath(locale, nextRoute)}>
          {copy.caseStudyLabels.nextProject}: {nextProject.title} →
        </a>
      </nav>
    </div>

    <script
      is:inline
      type="application/ld+json"
      set:html={serializedStructuredData}
    />
  </article>
</BaseLayout>

<style>
  .case-study__project-name {
    margin-bottom: 2rem;
    font-size: clamp(1.4rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .case-study__rail-inner {
    position: sticky;
    top: calc(75px + clamp(1rem, 3vw, 2rem));
    max-height: calc(100svh - 75px - clamp(2rem, 6vw, 4rem));
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .case-study__visual {
    margin-top: clamp(2rem, 5vw, 4rem);
  }

  .case-study__public-action {
    margin-top: 2rem;
  }

  .demo-note {
    max-width: 28ch;
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .case-study__rail-nav {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line);
  }

  .case-study__rail-nav ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-study__rail-nav a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.6rem;
    align-items: baseline;
    min-height: 44px;
    padding: 0.65rem 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.3;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition:
      color var(--motion-fast) var(--ease-settle),
      transform var(--motion-fast) var(--ease-out);
  }

  .case-study__rail-nav a span {
    color: var(--accent);
    font-size: 0.65rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  .case-study__rail-nav a:hover,
  .case-study__rail-nav a[aria-current='location'] {
    color: var(--ink);
    transform: translateX(3px);
  }

  @media (max-width: 760px) {
    .case-study__rail-inner {
      position: static;
      max-height: none;
      overflow-y: visible;
    }

    .case-study__rail-nav {
      display: none;
    }
  }

  .case-study__header {
    padding-bottom: clamp(2rem, 5vw, 4rem);
    margin-bottom: clamp(2rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line);
  }

  .case-study__header h1 {
    max-width: 17ch;
    margin-bottom: 1.5rem;
    font-size: clamp(2.2rem, 6vw, 5rem);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .case-study__intro {
    max-width: 62ch;
    margin-bottom: 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }

  .case-study__body h2 {
    margin-bottom: 1rem;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
  }

  .case-study__body section > :last-child {
    margin-bottom: 0;
  }

  .case-study__body ul {
    padding-left: 1.2rem;
  }

  .case-study__navigation {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .case-study__navigation a {
    font-weight: 700;
  }
</style>
